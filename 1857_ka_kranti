            exp: "भारत सरकार ने डॉ. सुरेन्द्र नाथ सेन (एस. एन. सेन) को 1857 के विद्रोह का आधिकारिक इतिहास लिखने का जिम्मा सौंपा था, उनकी पुस्तक का नाम 'Eighteen Fifty Seven' है।"
        }
    ];

    function shuffleArray(array) {
        for (let i = array.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
    }

    const quizContainer = document.getElementById("quiz");

    quizData.forEach((item, index) => {
        
        let shuffledOptions = shuffleArray([...item.options]);

        let qDiv = document.createElement("div");
        qDiv.className = "question-box";

        let qText = document.createElement("div");
        qText.className = "question-text";
        qText.innerText = item.q;
        qDiv.appendChild(qText);

        let optionsList = document.createElement("ul");
        optionsList.className = "options-list";

        let expDiv = document.createElement("div");
        expDiv.className = "explanation";
        expDiv.innerHTML = "<strong>💡 व्याख्या (Explanation):</strong> " + item.exp;

        shuffledOptions.forEach(opt => {
            let li = document.createElement("li");
            let btn = document.createElement("button");
            btn.className = "option-btn";
            btn.innerText = opt;

            btn.onclick = function() {
                let allBtns = optionsList.querySelectorAll(".option-btn");
                allBtns.forEach(b => b.disabled = true);

                if (opt === item.answer) {
                    btn.classList.add("correct");
                } else {
                    btn.classList.add("wrong");
                    allBtns.forEach(b => {
                        if (b.innerText === item.answer) {
                            b.classList.add("correct");
                        }
                    });
                }
                expDiv.style.display = "block";
            };

            li.appendChild(btn);
            optionsList.appendChild(li);
        });

        qDiv.appendChild(optionsList);
        qDiv.appendChild(expDiv);
        quizContainer.appendChild(qDiv);
    });
</script>

</body>
</html>
